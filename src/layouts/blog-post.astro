---
import BaseHead from '../components/base-head.astro';
import Footer from '../components/footer.astro';

const { title, description, pubDate, headings } = Astro.props;
---

<html lang="en">
	<head>
		<BaseHead title={title} description={description} />
		<style>
      article {
        .top {
          padding: var(--space-3xl);
          padding-top: var(--space-xl);
          padding-bottom: var(--space-sm);
          display: flex;
          flex-direction: column;
          gap: var(--space-xs);
          text-transform: lowercase;
        }

        .back {
          width: max-content;
          text-decoration: none;
          color: var(--color-fg);
          font-size: var(--font-md);
        }

        .title {
          padding: 1px var(--space-xs);
          margin-top: var(--space-5xl);
          font-size: var(--font-sm);
          font-weight: var(--weight-regular);
          line-height: 2;
          background: var(--color-primary);
          color: var(--color-bg);
          width: fit-content;
          text-wrap: wrap;
        }

        .middle {
          display: grid;
          grid-template-columns: 1fr 300px;
        }

        .prose {
          padding: var(--space-3xl);
          display: flex;
          flex-direction: column;
          gap: var(--space-xl);
          color: var(--color-fg);
          font-size: var(--font-sm);
          font-weight: var(--weight-medium);
          min-width: 100%;
          text-transform: lowercase;
        }
      }

      :global(.prose p) {
        line-height: 2;
      }
      :global(.prose a) {
        color: var(--color-primary);
        text-decoration: underline dotted;
      }
      :global(.prose a):hover {
        text-decoration: none;
      }
      :global(.prose h2) {
        font-size: var(--font-sm);
        font-weight: var(--weight-regular);
      }
      :global(.prose h2::before) {
        content: "// "
      }
      :global(.prose blockquote) {
        color: var(--color-gray-700);
        padding-left: var(--space-md);
        border-left: 4px solid var(--color-gray-500);
        font-style: italic;
      }
      :global(.prose code) {
        padding: 3px 6px;
        font-family: "commit-mono", monospace;
        font-size: var(--font-sm);
        background: var(--color-gray-150);
        color: var(--color-fg);
        border: 1px dashed var(--color-gray-250);
        text-transform: none;
      }
      :global(.prose a > code) {
        background: var(--color-primary);
        color: var(--color-bg);
        border: none;
      }
      :global(.prose pre) {
        padding: var(--space-lg);
        border: 1px dashed var(--color-gray-250);
        background-color: var(--color-gray-100) !important;
      }
      html.dark :global(.prose pre) {
        background-color: var(--color-gray-100) !important;
      }
      :global(.prose pre > code) {
        padding: 0;
        font-size: var(--font-sm);
        line-height: 2;
        border: none;
      }
      html.dark :global(.prose pre > code > * > *) {
        background-color: var(--color-gray-100) !important;
      }
      :global(.prose ul) {
        margin-top: calc(var(--space-xs) * -1);
        display: flex;
        flex-direction: column;
        gap: var(--space-2xs);
      }
      :global(.prose ul li) {
        color: var(--color-primary);
        text-transform: none;
      }
      :global(.prose ul li::before) {
        margin-right: var(--space-2xs);
        content: "> ";
      }

      @media (max-width: 700px) {
        .wrapper {
          .middle {
            grid-template-columns: 1fr;

            .prose {
              border: none;
            }
          }
        }
      }

      @media (max-width: 500px) {
        article {
          p, h1.title, pre, code, h2, ul, ol, li, a, a.back {
            font-size: var(--font-xs);
          }
          .title {
            margin-top: var(--space-2xl);
          }
          .top, .prose {
            padding: var(--space-lg);
          }
        }
      }
		</style>
	</head>
	<body>
    <div class="wrapper">
      <main>
        <article>
          <div class="top">
            <a href="/" class="back">&lt;&lt;</a>
            <h1 class="title">{title}</h1>
            <p class="date">{pubDate.toString().slice(4, 10).toUpperCase()}</p>
          </div>
          <div class="middle">
            <div class="prose">
              <slot />
            </div>
          </div>
        </article>
      </main>
      <Footer />
    </div>
	</body>
</html>
