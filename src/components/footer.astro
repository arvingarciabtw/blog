---
  import ThemeIcon from "./theme-icon.astro"
---

<footer class="footer">
  <ul class="socials-list">
    <li class="social">
      <a class="link" href="/rss.xml">RSS</a>
    </li>
    <li class="social">
      <a
        class="link"
        href="https://github.com/arvingarciabtw"
        target="_blank"
        rel="noopener noreferrer">Source</a
      >
    </li>
  </ul>
  <p class="developer">
    <a href="https://arvingarcia.com" target="_blank" rel="noopener noreferrer">
      @arvingarciabtw
    </a>
  </p>
  <div class="modes">
    <ThemeIcon />
  </div>
</footer>

<style>
  .footer {
    padding: var(--space-2xl) var(--space-3xl);
    padding-right: var(--space-2xl);
    width: 100%;
    max-width: 80rem;
    display: flex;
    justify-content: space-between;
    align-items: center;

    .developer, .socials-list {
      font-size: var(--font-sm);
      text-transform: lowercase;
      a {
        color: var(--color-fg);
        text-decoration: none;
        &:hover {
          text-decoration: underline;
        }
      }
    }

    .socials-list {
      padding: 0;
      display: flex;
      gap: var(--space-xl);
      list-style-type: none;

      .social {
        .link {
          color: var(--color-fg);
          text-decoration: none;
        }
        .link:hover {
          text-decoration: underline;
        }
      }
    }
  }

  @media (max-width: 700px) {
    .footer {
      .developer {
        display: none;
      }
    }
  }

  @media (max-width: 500px) {
    .footer {
      padding: var(--space-lg);
      gap: var(--space-md);

      .socials-list {
        gap: var(--space-lg);
        font-size: var(--font-xs);
      }
    }
  }
</style>
