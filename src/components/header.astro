---
---

<header>
  <div class="info">
    <p class="sub-info">i write about what i learn here.</p>
    <p class="sub-info">a blog by <a href="https://www.arvingarcia.com" target="_blank" rel="noopener noreferrer" class="developer">arvin garcia</a>.</p>
  </div>
</header>
<style>
	header {
    padding: var(--space-xl) var(--space-3xl);
    margin: auto;
		display: flex;
		align-items: center;
		justify-content: space-between;
    width: 100%;
    max-width: 80rem;

    .info {
      display: flex;
      flex-direction: column;
      gap: var(--space-2xs);
      font-size: 0.875rem;
      font-weight: var(--weight-medium);

      .developer {
        color: var(--color-primary);
        border-bottom: 1px dotted var(--color-primary);
        text-decoration: none;
      }

      .developer:hover {
        border-bottom-style: solid;
      }
    }
	}

  @media (max-width: 500px) {
    header {
      padding: var(--space-lg) var(--space-lg) var(--space-lg);
      flex-direction: column;
      align-items: start;
      gap: var(--space-lg);

      .info {
        font-size: var(--font-xs);

        .sub-info {
          text-align: left;
        }
      }
    }
  }
</style>
